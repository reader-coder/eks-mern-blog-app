# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Option A - Local Mongo container on the same docker network (service name "mongodb"):
MONGODB_URI=mongodb://mongodb:27017/blogdb

# Option B - MongoDB Atlas (cloud) cluster instead of a local container:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blogdb?retryWrites=true&w=majority

# Allowed origin for CORS (your frontend's URL)
CLIENT_ORIGIN=http://localhost:5173
